# Flutter 3.0.0 的 podhelper.rb 里用了 File.exists?，该方法在 Ruby 3.2 起被移除。
# Podfile 是被 CocoaPods 以 instance_eval 在 Pod::Podfile 上下文里求值的，
# 因此必须用 ::File 显式指向顶层类，否则 "class File" 会新建嵌套类
# Pod::Podfile::File 并报 undefined method `exist?'。
unless ::File.respond_to?(:exists?)
  ::File.define_singleton_method(:exists?) { |path| ::File.exist?(path) }
end

# Xcode 15+ 最低支持 iOS 12 deployment target，Xcode 16 起 deployment target
# 下限为 12.0；这里统一取 13.0，与 Runner.xcodeproj 里的 IPHONEOS_DEPLOYMENT_TARGET 保持一致。
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :profile,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # CocoaPods 在只构建 arm64 模拟器时会把 EXCLUDED_ARCHS 置空，
      # CocoaPods 1.16+ 的 target_validator 校验空 ARCHS 会抛
      # "undefined method `each' for nil"。这里补上默认值并清掉空的排除项。
      config.build_settings['ARCHS'] = '$(ARCHS_STANDARD)' if config.build_settings['ARCHS'].to_s.empty?
      config.build_settings.delete('EXCLUDED_ARCHS') if config.build_settings['EXCLUDED_ARCHS'].to_s.empty?
    end
  end

  # Xcode 15+ 不允许在 .xcconfig 里使用 DT_TOOLCHAIN_DIR（旧版 Flutter 会写入）。
  ::Dir.glob(::File.join(::File.dirname(::File.realpath(__FILE__)), 'Pods',
                         'Target Support Files', '**', '*.xcconfig')).each do |path|
    text = ::File.read(path)
    ::File.write(path, text.gsub('DT_TOOLCHAIN_DIR', 'TOOLCHAIN_DIR')) if text.include?('DT_TOOLCHAIN_DIR')
  end
end
