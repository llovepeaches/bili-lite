# 复制为 .env 后按需修改（服务本身零依赖，不读 .env，直接用环境变量即可）

# 服务监听端口 / 地址
PORT=8787
HOST=0.0.0.0

# 对外可访问的根地址；用于拼接演示授权页与回调页链接
# 生产环境请填备案的 https 域名，例如 https://bili.example.com
# PUBLIC_BASE_URL=http://localhost:8787

# 上游超时（毫秒）
UPSTREAM_TIMEOUT=10000

# 置为 1 时完全使用内置的真实数据快照，不请求 B 站（离线演示 / CI 用）
MOCK_MODE=0

# Flutter Web 构建产物目录；默认 ../../app/build/web
# WEB_DIR=/path/to/app/build/web

# ------------------------------------------------------------------
# 官方 OAuth 2.0（B 站开放平台）
# ------------------------------------------------------------------
# 前置条件：openhome.bilibili.com 完成开发者入驻 → 创建应用 → 申请 scope 并审核通过
#           → 在应用详情里把「授权回调域」填成下面的 BILI_REDIRECT_URI。
#
# client_secret 只在 BFF 进程内使用，绝不写入客户端、日志、Git 或响应。
# 建议在受信任的终端里注入，避免进入 shell 历史：
#   read -rsp 'BILI_CLIENT_SECRET: ' BILI_CLIENT_SECRET; export BILI_CLIENT_SECRET; echo
#
# BILI_CLIENT_ID=你的ClientID
# BILI_CLIENT_SECRET=你的Secret
# BILI_REDIRECT_URI=https://bili.example.com/api/oauth/callback
# BILI_OAUTH_SCOPES=USER_INFO

# 仅供本地链路自检：置为 1 时启用「演示授权」，模拟官方授权页与 token 端点。
# 它不连接 B 站、不产生真实凭证，UI 会明确标注「非 B 站官方」。
# 生产环境必须保持 0 / 不设置。
BILI_OAUTH_SANDBOX=0
